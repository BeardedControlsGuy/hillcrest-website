---
import settings from '../data/settings.json';
---
<section class="bg-navy text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-16 grid gap-10 md:grid-cols-2 items-center">
    <div class="reveal">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-gold">Stay Connected</p>
      <h2 class="mt-2 font-display text-3xl font-extrabold">Get the Church Center App</h2>
      <p class="mt-4 text-white/80 leading-relaxed">
        Church Center is Hillcrest's hub for everything happening on the hill — register for events,
        give online, fill out a connection card, and keep up with your groups, all from your phone.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="https://apps.apple.com/us/app/church-center-app/id1357742931" target="_blank" rel="noopener"
          class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition-colors">App Store</a>
        <a href="https://play.google.com/store/apps/details?id=com.ministrycentered.churchcenter" target="_blank" rel="noopener"
          class="rounded-full bg-white/10 px-5 py-2.5 text-sm font-bold hover:bg-white/20 transition-colors">Google Play</a>
        <a href={settings.church_center_url} target="_blank" rel="noopener"
          class="rounded-full bg-sky px-5 py-2.5 text-sm font-bold hover:bg-sky-bright transition-colors">Open in Browser</a>
      </div>
    </div>
    <div class="reveal grid grid-cols-2 gap-4">
      <a href={settings.giving_url} target="_blank" rel="noopener" class="rounded-xl bg-white/5 ring-1 ring-white/10 p-5 hover:bg-white/10 transition-colors">
        <p class="font-display font-bold">Give</p>
        <p class="mt-1 text-sm text-white/70">Tithes &amp; offerings, one-time or recurring</p>
      </a>
      <a href={settings.registrations_url} target="_blank" rel="noopener" class="rounded-xl bg-white/5 ring-1 ring-white/10 p-5 hover:bg-white/10 transition-colors">
        <p class="font-display font-bold">Event Sign-Ups</p>
        <p class="mt-1 text-sm text-white/70">Register for camps, clubs &amp; more</p>
      </a>
      <a href={settings.connection_card_url} target="_blank" rel="noopener" class="rounded-xl bg-white/5 ring-1 ring-white/10 p-5 hover:bg-white/10 transition-colors">
        <p class="font-display font-bold">Connection Card</p>
        <p class="mt-1 text-sm text-white/70">New here? Let us know you visited</p>
      </a>
      <a href={settings.church_center_url + '/groups'} target="_blank" rel="noopener" class="rounded-xl bg-white/5 ring-1 ring-white/10 p-5 hover:bg-white/10 transition-colors">
        <p class="font-display font-bold">Groups</p>
        <p class="mt-1 text-sm text-white/70">Find your people at Hillcrest</p>
      </a>
    </div>
  </div>
</section>
