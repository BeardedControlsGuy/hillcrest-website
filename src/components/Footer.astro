---
import settings from '../data/settings.json';
const year = new Date().getFullYear();
---
<footer class="bg-ink text-white">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 py-16">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-10">
      <div>
        <img src="/images/hbc_logo_white.png" alt="Hillcrest Baptist Church" class="h-12 w-auto" />
        <p class="mt-5 text-white/60 text-[15px] leading-relaxed">
          {settings.address_line1} · {settings.address_line2}<br />
          <a href="tel:+16154445923" class="hover:text-white">{settings.phone}</a> ·
          <a href={`mailto:${settings.email}`} class="hover:text-white">{settings.email}</a>
        </p>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-[15px] font-semibold text-white/75" aria-label="Footer">
        <a href="/visit" class="hover:text-white">Visit</a>
        <a href="/about" class="hover:text-white">About</a>
        <a href="/ministries" class="hover:text-white">Ministries</a>
        <a href="/sermons" class="hover:text-white">Sermons</a>
        <a href="/events" class="hover:text-white">Events</a>
        <a href={settings.giving_url} target="_blank" rel="noopener" class="hover:text-white">Give</a>
        <a href="/careers" class="hover:text-white">Careers</a>
        <a href="/contact" class="hover:text-white">Contact</a>
      </nav>
    </div>
    <div class="mt-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-t border-white/10 pt-6 text-sm text-white/45">
      <p>© {year} Hillcrest Baptist Church · Need GOD? He's Here!</p>
      <div class="flex gap-4">
        <a href={settings.facebook_url} target="_blank" rel="noopener" class="hover:text-white">Facebook</a>
        <a href={settings.instagram_url} target="_blank" rel="noopener" class="hover:text-white">Instagram</a>
        <a href={settings.youtube_url} target="_blank" rel="noopener" class="hover:text-white">YouTube</a>
        <a href={settings.church_center_url} target="_blank" rel="noopener" class="hover:text-white">Church Center</a>
      </div>
    </div>
  </div>
</footer>
