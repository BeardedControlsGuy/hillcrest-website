---
import settings from '../data/settings.json';
import times from '../data/service-times.json';
const year = new Date().getFullYear();
---
<footer class="bg-ink text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-14 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-2">
      <img src="/images/hbc_logo_white.png" alt="Hillcrest Baptist Church" class="h-12 w-auto" />
      <p class="mt-4 text-white/70 text-sm max-w-sm">
        {settings.address_line1}, {settings.address_line2}<br />
        Tel: <a href={`tel:+16154445923`} class="hover:text-white">{settings.phone}</a><br />
        <a href={`mailto:${settings.email}`} class="hover:text-white">{settings.email}</a>
      </p>
      <div class="mt-5 flex gap-3">
        <a href={settings.facebook_url} target="_blank" rel="noopener" aria-label="Facebook" class="rounded-full bg-white/10 p-2.5 hover:bg-sky transition-colors">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.09 24 18.1 24 12.07z"/></svg>
        </a>
        <a href={settings.instagram_url} target="_blank" rel="noopener" aria-label="Instagram" class="rounded-full bg-white/10 p-2.5 hover:bg-sky transition-colors">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98 1.28.06 1.69.07 4.95.07s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84zm0 10.15A3.99 3.99 0 1 1 16 12a3.99 3.99 0 0 1-4 3.99zm6.41-11.85a1.44 1.44 0 1 0 1.43 1.44 1.44 1.44 0 0 0-1.43-1.44z"/></svg>
        </a>
        <a href={settings.youtube_url} target="_blank" rel="noopener" aria-label="YouTube" class="rounded-full bg-white/10 p-2.5 hover:bg-sky transition-colors">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.81 3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.81zM9.55 15.57V8.43L15.82 12z"/></svg>
        </a>
      </div>
    </div>

    <div>
      <h3 class="font-display text-sm font-bold uppercase tracking-wider text-gold">Worship Times</h3>
      <ul class="mt-4 space-y-1.5 text-sm text-white/70">
        {times.sunday.map((s) => <li>Sun {s.time} — {s.name}</li>)}
        {times.wednesday.map((s) => <li>Wed {s.time} — {s.name}</li>)}
      </ul>
    </div>

    <div>
      <h3 class="font-display text-sm font-bold uppercase tracking-wider text-gold">Quick Links</h3>
      <ul class="mt-4 space-y-1.5 text-sm text-white/70">
        <li><a href="/visit" class="hover:text-white">Plan Your Visit</a></li>
        <li><a href="/about" class="hover:text-white">About</a></li>
        <li><a href="/staff" class="hover:text-white">Staff</a></li>
        <li><a href="/events" class="hover:text-white">Events</a></li>
        <li><a href={settings.giving_url} target="_blank" rel="noopener" class="hover:text-white">Give</a></li>
        <li><a href="/careers" class="hover:text-white">Careers</a></li>
        <li><a href="/contact" class="hover:text-white">Contact</a></li>
      </ul>
      <h3 class="mt-6 font-display text-sm font-bold uppercase tracking-wider text-gold">Church Center</h3>
      <ul class="mt-4 space-y-1.5 text-sm text-white/70">
        <li><a href={settings.church_center_url} target="_blank" rel="noopener" class="hover:text-white">Church Center Web</a></li>
        <li><a href="https://apps.apple.com/us/app/church-center-app/id1357742931" target="_blank" rel="noopener" class="hover:text-white">iPhone App</a></li>
        <li><a href="https://play.google.com/store/apps/details?id=com.ministrycentered.churchcenter" target="_blank" rel="noopener" class="hover:text-white">Android App</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 py-5 text-center text-xs text-white/50">
    © {year} Hillcrest Baptist Church. All Rights Reserved.
  </div>
</footer>
