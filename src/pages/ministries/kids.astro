---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Gallery from '../../components/Gallery.astro';
import { Image } from 'astro:assets';
import hero from '../../assets/img/uploads/kids_main_photo.jpg';
import s1 from '../../assets/img/uploads/kids_section_one_photo.jpg';
import awana from '../../assets/img/uploads/kids_section_two_photo.jpg';
import cc from '../../assets/img/uploads/kids_section_three_photo.jpg';
import pre1 from '../../assets/img/uploads/preschool_section_one_1_photo.jpg';

const gallery = Object.values(
  import.meta.glob('../../assets/img/uploads/preschool_gallery_*.jpg', { eager: true, import: 'default' })
) as ImageMetadata[];
---
<Layout title="Kids at Hillcrest | Hillcrest Baptist Church">
  <PageHero
    eyebrow="Birth – 6th Grade"
    title="Kids at Hillcrest"
    subtitle="From the nursery to AWANA, we want every child to LOVE the Word, LEARN the Word, LIVE the Word — and stay in it their entire life."
    image={hero}
    tall
  >
    <div class="mt-8 flex flex-wrap gap-3 text-sm font-bold">
      <a href="#preschool" class="rounded-full bg-white/10 ring-1 ring-white/25 px-5 py-2 hover:bg-white/20">Preschool</a>
      <a href="#children" class="rounded-full bg-white/10 ring-1 ring-white/25 px-5 py-2 hover:bg-white/20">Children's Ministry</a>
      <a href="#awana" class="rounded-full bg-white/10 ring-1 ring-white/25 px-5 py-2 hover:bg-white/20">AWANA</a>
    </div>
  </PageHero>

  <section id="preschool" class="bg-white scroll-mt-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-16 md:py-24 grid gap-10 md:grid-cols-2 items-center">
      <div class="reveal">
        <SectionHeading eyebrow="Newborn – Kindergarten" title="Preschool" />
        <div class="mt-6 space-y-4 text-slate-700 leading-relaxed">
          <p class="italic text-navy font-semibold">"And Jesus increased in wisdom and stature, and in favor with God and men." — Luke 2:52</p>
          <p>
            Our Preschool Ministry provides a secure, nurturing environment for infants through
            Kindergarteners where biblical truths are taught as a foundation for salvation and
            Christian living. Activity-based teaching helps little ones understand that God is our
            creator, Jesus is God's Son and our best friend, and the Bible is a true and special book.
          </p>
          <p>
            There's a check-in/check-out security system at every service, and the Preschool
            Department opens <strong>15 minutes before</strong> worship, Sunday School, and AWANA.
            The nursery is in the E-Center, upstairs from the main hallway of the sanctuary.
          </p>
        </div>
      </div>
      <div class="reveal overflow-hidden rounded-3xl shadow-lg">
        <Image src={pre1} alt="Preschool Ministry" widths={[600, 1200]} sizes="(min-width: 768px) 50vw, 100vw" class="w-full object-cover" loading="lazy" />
      </div>
    </div>
  </section>

  <section id="children" class="bg-cream scroll-mt-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-16 md:py-24 grid gap-10 md:grid-cols-2 items-center">
      <div class="reveal overflow-hidden rounded-3xl shadow-lg md:order-1">
        <Image src={s1} alt="Children's Ministry" widths={[600, 1200]} sizes="(min-width: 768px) 50vw, 100vw" class="w-full object-cover" loading="lazy" />
      </div>
      <div class="reveal md:order-2">
        <SectionHeading eyebrow="K – 6th Grade" title="Children's Ministry" />
        <div class="mt-6 space-y-4 text-slate-700 leading-relaxed">
          <p class="italic text-navy font-semibold">"Let the little children come to Me, and do not forbid them; for of such is the kingdom of heaven." — Matthew 19:14</p>
          <p>
            We partner with parents to raise Deuteronomy 6 families — talking about Jesus when we sit
            at home, walk, lie down, and rise. Along with Sunday School,
            <strong>Children's Church</strong> meets every Sunday during the 11 AM worship hour for
            Kindergarten through 2nd grade.
          </p>
          <p>
            Watch for favorites through the year like <strong>Parent's Night Out</strong> and
            <strong>Children's Camp</strong> each summer!
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="awana" class="relative isolate overflow-hidden text-white scroll-mt-24">
    <Image src={awana} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover" widths={[768, 1600]} sizes="100vw" loading="lazy" />
    <div class="absolute inset-0 -z-10 bg-navy-deep/85"></div>
    <div class="mx-auto max-w-4xl px-5 sm:px-8 py-20 md:py-28 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.25em] text-gold">Wednesdays 6:45–8:00 PM · School Year</p>
      <h2 class="mt-3 font-display text-4xl md:text-5xl font-extrabold">AWANA</h2>
      <p class="mx-auto mt-6 max-w-2xl text-white/85 leading-relaxed">
        "Approved Workmen Are Not Ashamed" (2 Timothy 2:15) — a great night where kids learn the
        Bible and memorize scripture in a fun, exciting way. Puggles (age 2) · Cubbies (3–4) ·
        Sparks (K–2nd) · Truth &amp; Training (3rd–6th). Everyone is welcome!
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="https://hillcrestbaptisttn.churchcenter.com/registrations" target="_blank" rel="noopener" class="rounded-full bg-sky px-7 py-3 font-bold hover:bg-sky-bright transition-colors">Register in Church Center</a>
        <a href="https://www.awana.org/" target="_blank" rel="noopener" class="rounded-full bg-white/10 px-7 py-3 font-bold ring-1 ring-white/25 hover:bg-white/20 transition-colors">About AWANA</a>
      </div>
    </div>
  </section>

  {gallery.length > 0 && (
    <section class="bg-white">
      <div class="mx-auto max-w-7xl px-5 sm:px-8 py-16">
        <SectionHeading eyebrow="Photos" title="Kids Gallery" />
        <div class="mt-8"><Gallery images={gallery} alt="Kids at Hillcrest" /></div>
      </div>
    </section>
  )}
</Layout>
