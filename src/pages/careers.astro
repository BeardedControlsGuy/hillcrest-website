---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import settings from '../data/settings.json';
import careers from '../data/careers.json';
---
<Layout title="Careers | Hillcrest Baptist Church">
  <section class="bg-navy-deep text-white">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 pt-36 pb-16 md:pt-40 md:pb-20 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-gold">Join Our Team</p>
      <h1 class="mt-2 font-display text-4xl md:text-5xl font-extrabold">Careers at Hillcrest</h1>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">{careers.intro}</p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 py-16">
      {careers.positions.length === 0 ? (
        <div class="rounded-2xl bg-cream p-10 ring-1 ring-black/5 text-center">
          <h2 class="font-display text-2xl font-extrabold text-navy">There are no positions available at this time.</h2>
          <p class="mt-3 text-slate-600">Please continue to check back frequently. As we grow, we will have more positions available.</p>
        </div>
      ) : (
        <div class="space-y-6">
          {careers.positions.map((p) => (
            <div class="reveal rounded-2xl bg-cream p-8 ring-1 ring-black/5">
              <h2 class="font-display text-xl font-extrabold text-navy">{p.title}</h2>
              <p class="mt-3 whitespace-pre-line text-slate-700 leading-relaxed">{p.description}</p>
              <a href={p.apply_url || `mailto:${settings.email}?subject=${encodeURIComponent('Application: ' + p.title)}`}
                class="mt-5 inline-block rounded-full bg-navy px-6 py-2.5 font-bold text-white hover:bg-sky transition-colors">Apply</a>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
