---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found | Hillcrest Baptist Church">
  <section class="bg-navy-deep text-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 pt-44 pb-28 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-gold">404</p>
      <h1 class="mt-2 font-display text-4xl font-extrabold">Page Not Found</h1>
      <p class="mt-4 text-white/80">The page you're looking for may have moved when we updated our website.</p>
      <a href="/" class="mt-8 inline-block rounded-full bg-sky px-7 py-3 font-bold hover:bg-sky-bright transition-colors">Back to Home</a>
    </div>
  </section>
</Layout>
