---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import hero from '../assets/img/uploads/staff_main_photo.jpg';
import staff from '../data/staff.json';
---
<Layout title="Staff | Hillcrest Baptist Church">
  <PageHero
    title="Hillcrest Staff"
    subtitle="Here at HBC we are blessed to have such a loving congregation and great staff. Each one of our ministers is a unique and gifted individual who loves the Lord Jesus and desires to reach others with the saving knowledge of Jesus Christ."
    image={hero}
  />

  <section class="bg-cream">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-16 md:py-20 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {staff.members.map((m) => (
        <div class="reveal rounded-2xl bg-white shadow-sm ring-1 ring-black/5 overflow-hidden flex flex-col">
          <img src={m.photo} alt={m.name} class="aspect-[4/4.4] w-full object-cover object-top" loading="lazy" />
          <div class="p-6 flex-1 flex flex-col">
            <h2 class="font-display text-xl font-bold text-navy">{m.name}</h2>
            <p class="mt-1 text-sm font-bold uppercase tracking-wider text-sky">{m.title}</p>
            {m.bio && (
              <details class="mt-4 group">
                <summary class="cursor-pointer list-none text-sm font-bold text-gold hover:text-navy transition-colors">
                  <span class="group-open:hidden">Read bio ▾</span>
                  <span class="hidden group-open:inline">Hide bio ▴</span>
                </summary>
                <p class="mt-3 whitespace-pre-line text-sm text-slate-600 leading-relaxed">{m.bio}</p>
              </details>
            )}
            {m.email && (
              <a href={`mailto:${m.email}`} class="mt-auto pt-4 text-sm font-semibold text-slate-500 hover:text-sky">{m.email}</a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
