---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import ChurchCenterPromo from '../components/ChurchCenterPromo.astro';
import settings from '../data/settings.json';
import times from '../data/service-times.json';
import announcements from '../data/announcements.json';
import feed from '../data/sermons-videos.json';

import heroImg from '../assets/img/uploads/home_worship_times_graphic.jpg';
import kidsImg from '../assets/img/uploads/home_ministry_left_graphic.jpg';
import youthImg from '../assets/img/uploads/home_ministry_right_graphic.jpg';
import adultsImg from '../assets/img/uploads/hbc_womens_ministry.jpg';
import musicImg from '../assets/img/uploads/home_ministry_three_graphic.jpg';
import missionsImg from '../assets/img/uploads/home_ministry_four_graphic.jpg';

const activeAnnouncements = announcements.items.filter((a) => a.active);
const latest = feed.videos[0];
const ministries = [
  { title: 'Kids', img: kidsImg, href: '/ministries/kids' },
  { title: 'Students', img: youthImg, href: '/ministries/students' },
  { title: 'Adults', img: adultsImg, href: '/ministries/adults' },
  { title: 'Music', img: musicImg, href: '/ministries/music' },
  { title: 'Missions', img: missionsImg, href: '/ministries/missions' },
];
---
<Layout title="Hillcrest Baptist Church | Lebanon, TN">
  <!-- Full-height hero -->
  <section class="relative isolate overflow-hidden bg-navy-deep text-white flex items-center min-h-[94vh]">
    <Image src={heroImg} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/70 via-navy-deep/40 to-ink/90"></div>
    <div class="mx-auto w-full max-w-7xl px-5 sm:px-8 pt-28 pb-20">
      <p class="font-display text-sm md:text-base font-bold uppercase tracking-[0.35em] text-gold">{settings.tagline}</p>
      <h1 class="mt-5 max-w-4xl font-display text-5xl md:text-8xl font-extrabold tracking-tight leading-[0.95]">Welcome to Hillcrest</h1>
      <p class="mt-7 max-w-xl text-lg md:text-xl text-white/85 leading-relaxed">
        A church family on the hill in Lebanon, Tennessee — where everyone belongs and
        Jesus Christ is Lord. Need GOD? He's here.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/visit" class="rounded-full bg-sky px-8 py-3.5 font-bold text-white hover:bg-sky-bright transition-colors">Plan Your Visit</a>
        <a href="/sermons" class="rounded-full bg-white/10 px-8 py-3.5 font-bold text-white ring-1 ring-white/30 hover:bg-white/20 transition-colors">Watch a Service</a>
      </div>
    </div>
    <a href="#sundays" aria-label="Scroll down" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white/60 hover:text-white">
      <svg class="h-7 w-7 animate-bounce" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </a>
  </section>

  <!-- Sundays band -->
  <section id="sundays" class="bg-white">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-16 md:py-24 grid gap-10 md:grid-cols-[1fr_auto] md:items-center">
      <div class="reveal">
        <p class="text-sm font-bold uppercase tracking-[0.25em] text-sky">Join Us</p>
        <h2 class="mt-2 font-display text-3xl md:text-5xl font-extrabold text-navy tracking-tight">Sundays &amp; Wednesdays on the hill</h2>
        <p class="mt-4 max-w-xl text-slate-600 text-lg">Biblical preaching, Christ-exalting worship, and a place for every age — {settings.address_line1}, {settings.address_line2}.</p>
      </div>
      <div class="reveal grid grid-cols-2 gap-8 text-[15px]">
        <div>
          <p class="font-display font-bold text-gold uppercase tracking-wider text-sm">Sunday</p>
          <ul class="mt-3 space-y-1.5 text-slate-700">
            {times.sunday.map((s) => <li><span class="font-bold text-navy">{s.time}</span> · {s.name}</li>)}
          </ul>
        </div>
        <div>
          <p class="font-display font-bold text-gold uppercase tracking-wider text-sm">Wednesday</p>
          <ul class="mt-3 space-y-1.5 text-slate-700">
            {times.wednesday.map((s) => <li><span class="font-bold text-navy">{s.time}</span> · {s.name}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Announcements -->
  {activeAnnouncements.length > 0 && (
    <section class="bg-cream">
      <div class="mx-auto max-w-7xl px-5 sm:px-8 py-16 md:py-24 space-y-16">
        <SectionHeading eyebrow="What's Happening" title="Announcements" />
        {activeAnnouncements.map((a, i) => (
          <div class:list={["reveal grid gap-10 md:grid-cols-2 items-center", i % 2 === 1 && "md:[&>*:first-child]:order-2"]}>
            <div class="overflow-hidden rounded-3xl shadow-lg">
              <img src={a.image} alt={a.title} class="w-full object-cover" loading="lazy" />
            </div>
            <div>
              <h3 class="font-display text-3xl md:text-4xl font-extrabold text-navy tracking-tight">{a.title}</h3>
              {a.subtitle && <p class="mt-2 font-semibold text-sky text-lg">{a.subtitle}</p>}
              <p class="mt-5 whitespace-pre-line text-slate-700 leading-relaxed">{a.body}</p>
              {a.button_url && (
                <a href={a.button_url} target={a.button_url.startsWith('http') ? '_blank' : undefined} rel="noopener"
                  class="mt-7 inline-block rounded-full bg-navy px-7 py-3 font-bold text-white hover:bg-sky transition-colors">{a.button_label}</a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Ministries strip -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-16 md:py-24">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading eyebrow="Get Connected" title="A place for everyone" />
        <a href="/ministries" class="font-bold text-sky hover:underline">All ministries &amp; next steps →</a>
      </div>
      <div class="mt-10 grid gap-4 grid-cols-2 lg:grid-cols-5">
        {ministries.map((m) => (
          <a href={m.href} class="reveal group relative isolate overflow-hidden rounded-2xl aspect-[4/5] flex items-end">
            <Image src={m.img} alt={m.title} widths={[400, 800]} sizes="(min-width: 1024px) 20vw, 50vw"
              class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/80 via-ink/15 to-transparent"></div>
            <div class="p-5">
              <h3 class="font-display text-xl font-extrabold text-white">{m.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest service -->
  {latest && (
    <section class="bg-navy-deep text-white">
      <div class="mx-auto max-w-7xl px-5 sm:px-8 py-16 md:py-24 grid gap-10 md:grid-cols-2 items-center">
        <div class="reveal">
          <SectionHeading eyebrow="Missed a Sunday?" title="Watch the latest service" light />
          <p class="mt-5 text-white/80 text-lg">{latest.title}</p>
          <div class="mt-7 flex flex-wrap gap-4">
            <a href="/sermons" class="rounded-full bg-sky px-7 py-3 font-bold hover:bg-sky-bright transition-colors">All Sermons</a>
            <a href="/podcasts" class="rounded-full bg-white/10 px-7 py-3 font-bold ring-1 ring-white/25 hover:bg-white/20 transition-colors">Podcasts</a>
          </div>
        </div>
        <div class="reveal">
          <VideoEmbed id={latest.id} title={latest.title} />
        </div>
      </div>
    </section>
  )}

  <ChurchCenterPromo />

  <!-- Visit / map -->
  <section class="bg-cream">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-16 md:py-24 grid gap-10 md:grid-cols-2 items-center">
      <div class="reveal">
        <SectionHeading eyebrow="Visit Us" title="We'd love to meet you" />
        <p class="mt-6 text-slate-700 leading-relaxed italic text-lg">
          "For where two or three are gathered together in my name, there am I in the midst of them." — Matthew 18:20
        </p>
        <a href="/visit" class="mt-7 inline-block rounded-full bg-navy px-7 py-3 font-bold text-white hover:bg-sky transition-colors">What to Expect</a>
      </div>
      <div class="reveal overflow-hidden rounded-3xl shadow-lg">
        <iframe
          title="Map to Hillcrest Baptist Church"
          src="https://www.google.com/maps?q=Hillcrest+Baptist+Church,+621+Hartsville+Pike,+Lebanon,+TN+37087&output=embed"
          class="h-96 w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
